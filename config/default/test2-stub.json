[
  {
    "request": {
      "method": "GET",
      "url": "/api/v2/user/{id}/{region}?role={role}&active={active}"
    },
    "response": {
      "status": 200,
      "body": {
        "id": "{id}",
        "region": "{region}",
        "username": "user_{id}",
        "role": "{role}",
        "isActive": "{active}"
      }
    }
  }
]